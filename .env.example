PORT=4000
# Comma-separate local and deployed frontend origins when both are needed.
CLIENT_URL=http://localhost:5173,https://your-frontend-domain.example

# Required for database-backed routes. Create a project at supabase.com,
# then paste Project URL and anon public key from Settings → API.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Recommended in production: server-only key used by the API for protected
# approval operations. Never expose this as a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# HMAC secret for admin session tokens. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_SECONDS=43200

# Frontend-to-API URL. Use your deployed API URL in the production frontend;
# omit it only when intentionally running the offline demo.
# Must point at the backend (Render), NOT at Supabase.
VITE_API_URL=https://your-backend.onrender.com
